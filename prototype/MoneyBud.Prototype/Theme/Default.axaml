<!--
  The default theme: every colour the prototype uses, by name, once for dark and once for light.
  Nothing else in the prototype names a colour, so a new theme is a new copy of this file.
  The slice colours are Colors, not brushes, because the ring's painter mixes them itself.
  PanelEdge, CardEdge, the grain and the heading font exist for other themes; here they leave the
  look as it was.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <FontFamily x:Key="HeadingFont">fonts:Inter#Inter, $Default</FontFamily>
  <sys:Double x:Key="H1Size">30</sys:Double>
  <sys:Double x:Key="H2Size">21</sys:Double>
  <!-- What a panel does to the home screen under it: glass blurs and darkens it. -->
  <sys:Double x:Key="HomeBlur">22</sys:Double>
  <sys:Double x:Key="HomeDim">0.32</sys:Double>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#0B0D12</Color>
      <Color x:Key="GlowColor">#2E6F86FF</Color>
      <Color x:Key="LineColor">#1CFFFFFF</Color>
      <Color x:Key="UnassignedColor">#39404F</Color>
      <Color x:Key="DangerColor">#FF6B6B</Color>

      <Color x:Key="Slice0">#5FD4B0</Color>
      <Color x:Key="Slice1">#7C9CFF</Color>
      <Color x:Key="Slice2">#FFB86B</Color>
      <Color x:Key="Slice3">#B48CFF</Color>
      <Color x:Key="Slice4">#6CCBFF</Color>
      <Color x:Key="Slice5">#FF8FA8</Color>
      <Color x:Key="Slice6">#E8D36A</Color>
      <Color x:Key="Slice7">#9BE07A</Color>

      <SolidColorBrush x:Key="Bg" Color="#0B0D12" />
      <SolidColorBrush x:Key="Glass" Color="#C8121620" />
      <SolidColorBrush x:Key="GlassEdge" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="Card" Color="#1A1F2A" />
      <SolidColorBrush x:Key="Field" Color="#222837" />
      <SolidColorBrush x:Key="Line" Color="#1CFFFFFF" />
      <SolidColorBrush x:Key="Text" Color="#F2F4F8" />
      <SolidColorBrush x:Key="Muted" Color="#8C95A8" />
      <SolidColorBrush x:Key="Faint" Color="#596176" />
      <SolidColorBrush x:Key="Accent" Color="#8FA6FF" />
      <SolidColorBrush x:Key="OnAccent" Color="#0B0D12" />
      <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Positive" Color="#5FD4A0" />
      <SolidColorBrush x:Key="Handle" Color="#44FFFFFF" />
      <SolidColorBrush x:Key="Toast" Color="#F02A3142" />
      <SolidColorBrush x:Key="HoleBackdrop" Color="Transparent" />
      <SolidColorBrush x:Key="PanelEdge" Color="Transparent" />
      <SolidColorBrush x:Key="CardEdge" Color="Transparent" />
      <sys:Double x:Key="GrainOpacity">0</sys:Double>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgColor">#F4F5F8</Color>
      <Color x:Key="GlowColor">#265A78F0</Color>
      <Color x:Key="LineColor">#1A0B0D12</Color>
      <Color x:Key="UnassignedColor">#D3D8E2</Color>
      <Color x:Key="DangerColor">#D83A3A</Color>

      <Color x:Key="Slice0">#1FA383</Color>
      <Color x:Key="Slice1">#4D6FE0</Color>
      <Color x:Key="Slice2">#E08A2E</Color>
      <Color x:Key="Slice3">#8A5CE6</Color>
      <Color x:Key="Slice4">#2E9FD9</Color>
      <Color x:Key="Slice5">#E0507A</Color>
      <Color x:Key="Slice6">#BFA02E</Color>
      <Color x:Key="Slice7">#5CAF3A</Color>

      <SolidColorBrush x:Key="Bg" Color="#F4F5F8" />
      <SolidColorBrush x:Key="Glass" Color="#D9FFFFFF" />
      <SolidColorBrush x:Key="GlassEdge" Color="#140B0D12" />
      <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Field" Color="#EBEDF2" />
      <SolidColorBrush x:Key="Line" Color="#1A0B0D12" />
      <SolidColorBrush x:Key="Text" Color="#12151C" />
      <SolidColorBrush x:Key="Muted" Color="#646C7E" />
      <SolidColorBrush x:Key="Faint" Color="#9AA1B0" />
      <SolidColorBrush x:Key="Accent" Color="#4D66E6" />
      <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Danger" Color="#D83A3A" />
      <SolidColorBrush x:Key="Positive" Color="#1F9C6A" />
      <SolidColorBrush x:Key="Handle" Color="#330B0D12" />
      <SolidColorBrush x:Key="Toast" Color="#F21C2130" />
      <SolidColorBrush x:Key="HoleBackdrop" Color="Transparent" />
      <SolidColorBrush x:Key="PanelEdge" Color="Transparent" />
      <SolidColorBrush x:Key="CardEdge" Color="Transparent" />
      <sys:Double x:Key="GrainOpacity">0</sys:Double>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
