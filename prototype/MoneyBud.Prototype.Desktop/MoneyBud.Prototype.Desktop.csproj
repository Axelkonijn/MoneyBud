<Project Sdk="Microsoft.NET.Sdk">

  <!-- The prototype in a phone-sized window, for trying it on the PC. The mouse stands in for a
       finger: drag to swipe, hold and drag on the ring to scrub. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoneyBud.Prototype\MoneyBud.Prototype.csproj" />
  </ItemGroup>

</Project>
