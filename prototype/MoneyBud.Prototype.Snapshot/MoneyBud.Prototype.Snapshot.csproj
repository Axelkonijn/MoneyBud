<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the prototype off-screen and saves pictures of it, driving it with a pretend mouse:
       a way to look at the screens without a phone. Not part of the prototype itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoneyBud.Prototype\MoneyBud.Prototype.csproj" />
  </ItemGroup>

</Project>
