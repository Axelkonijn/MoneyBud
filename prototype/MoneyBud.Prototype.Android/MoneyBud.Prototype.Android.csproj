<Project Sdk="Microsoft.NET.Sdk">

  <!-- The prototype on the phone. Only what Android needs lives here: the activity, the
       vibration, the window's colours. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>app.moneybud.prototype</ApplicationId>
    <ApplicationTitle>MoneyBud prototype</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The Android build wants JDK 17 or 21; the newest Java on the PATH may be too new. -->
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Java\jdk-21.0.10')">
    <JavaSdkDirectory>C:\Program Files\Java\jdk-21.0.10</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoneyBud.Prototype\MoneyBud.Prototype.csproj" />
  </ItemGroup>

</Project>
