<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoneyBud.Phone.App"
             RequestedThemeVariant="Default">
  <!-- The first merged dictionary is the theme's: switching themes replaces it (Theme/Looks.cs). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MoneyBud.Phone/Theme/Default.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MoneyBud.Phone/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
