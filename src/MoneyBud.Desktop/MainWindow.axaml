<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:MoneyBud.Presentation"
        xmlns:d="using:MoneyBud.Desktop"
        xmlns:dom="using:MoneyBud.Domain"
        x:Class="MoneyBud.Desktop.MainWindow"
        x:DataType="p:MoneyBudApp"
        Title="MoneyBud"
        Width="1320" Height="900" MinWidth="1000" MinHeight="720"
        Background="#F6F7F9">

  <!-- Income on the left, the plan in the middle, expenses on the right: the stakeholder's own
       picture of the screen (arc42 §12), under a strip of accounts. Every word shown comes from
       Tekst. -->

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#5C6670" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderBrush" Value="#E2E6EA" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.marker">
      <Setter Property="Background" Value="#C0392B" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.marker > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox, AutoCompleteBox, CalendarDatePicker, ComboBox">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- An account in the strip: clicking it opens its history. -->
    <Style Selector="Button.account">
      <Setter Property="Background" Value="#F6F7F9" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.account.open">
      <Setter Property="Background" Value="#E8F4F1" />
    </Style>
    <!-- The Hoofdrekening's badge. -->
    <Style Selector="Border.pool">
      <Setter Property="Background" Value="#E8F4F1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pool > TextBlock">
      <Setter Property="Foreground" Value="#1F6F63" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- A row in a transaction list: clicking it loads the entry into its form (arc42 §12). -->
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- The small buttons under a category's name. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1F6F63" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- The badge that says a form is changing an entry rather than recording one. -->
    <Style Selector="Border.editing">
      <Setter Property="Background" Value="#FFF4E0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <!-- The period on screen, and stepping. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <Button Grid.Column="0" Command="{Binding StepBackCommand}"
              Content="{x:Static p:Tekst.PreviousPeriod}" />
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding PeriodTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border IsVisible="{Binding ShowsCurrentPeriod}" Background="#E8F4F1" CornerRadius="10"
                Padding="8,2" VerticalAlignment="Center">
          <TextBlock Text="{Binding PeriodLabel}" FontSize="12" Foreground="#1F6F63" />
        </Border>
      </StackPanel>
      <Button Grid.Column="2" Command="{Binding StepForwardCommand}"
              Content="{x:Static p:Tekst.NextPeriod}" />
    </Grid>

    <!-- ======================= Accounts =======================
         The strip across the top: every account's Saldo today, the Hoofdrekening first, then
         Vermogen. The same in every period, because a balance is about today (arc42 §12, Accounts
         and net worth). Clicking an account opens its history underneath; the forms for adding an
         account and for a transfer open in the same place. -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
      <Border Classes="card" Padding="10">
        <Grid ColumnDefinitions="*,16,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:AccountLine">
                  <Button Classes="account" Classes.open="{Binding IsOpen}" CommandParameter="{Binding Account}"
                          Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).OpenHistoryCommand}">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Classes="pool" IsVisible="{Binding IsPool}">
                          <TextBlock Text="{Binding PoolText}" />
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding BalanceText}" VerticalAlignment="Center" />
                        <Border Classes="marker" IsVisible="{Binding IsOverdrawn}">
                          <TextBlock Text="{x:Static p:Tekst.Overdrawn}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Static p:Tekst.NetWorth}" Classes="caption" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding NetWorthText}" FontSize="17" FontWeight="SemiBold" />
                <Border Classes="marker" IsVisible="{Binding IsNetWorthNegative}">
                  <TextBlock Text="{x:Static p:Tekst.Overdrawn}" />
                </Border>
              </StackPanel>
            </StackPanel>
            <Button Content="{x:Static p:Tekst.AddAccount}" Command="{Binding AccountForm.OpenCommand}" />
            <Button Content="{x:Static p:Tekst.TransferAct}" Command="{Binding TransferForm.OpenCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Adding an account: a name, and the balance the bank shows today, which may be left empty. -->
      <Border Classes="card" Padding="10" IsVisible="{Binding AccountForm.IsOpen}">
        <Grid DataContext="{Binding AccountForm}" x:DataType="p:AccountForm" ColumnDefinitions="*,8,*,8,Auto,8,Auto">
          <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="{x:Static p:Tekst.Account}" Margin="0" />
          <TextBox Grid.Column="2" Text="{Binding StartingBalance}" PlaceholderText="{x:Static p:Tekst.StartingBalance}" Margin="0" />
          <Button Grid.Column="4" Content="{x:Static p:Tekst.AddAccount}" Command="{Binding SubmitCommand}" Classes="accent" />
          <Button Grid.Column="6" Content="{x:Static p:Tekst.Cancel}" Command="{Binding CancelCommand}" />
        </Grid>
      </Border>

      <!-- A transfer: Van, Naar, Bedrag, Datum. Loaded from a history row, it is changed or removed. -->
      <Border Classes="card" Padding="10" IsVisible="{Binding TransferForm.IsOpen}">
        <Grid DataContext="{Binding TransferForm}" x:DataType="p:TransferForm"
              ColumnDefinitions="Auto,*,8,*,8,*,8,*,8,Auto,8,Auto,8,Auto">
          <Border Grid.Column="0" Classes="editing" IsVisible="{Binding IsEditing}" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{x:Static p:Tekst.Change}" FontSize="12" />
          </Border>
          <ComboBox Grid.Column="1" Margin="0" HorizontalAlignment="Stretch" PlaceholderText="{x:Static p:Tekst.From}"
                    ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).AccountChoices}"
                    SelectedItem="{Binding ChosenFrom}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dom:Account">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="3" Margin="0" HorizontalAlignment="Stretch" PlaceholderText="{x:Static p:Tekst.To}"
                    ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).AccountChoices}"
                    SelectedItem="{Binding ChosenTo}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dom:Account">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Grid.Column="5" Text="{Binding Amount}" PlaceholderText="{x:Static p:Tekst.Amount}" Margin="0" />
          <CalendarDatePicker Grid.Column="7" SelectedDate="{Binding Date}" PlaceholderText="{x:Static p:Tekst.Today}"
                              HorizontalAlignment="Stretch" Margin="0" />
          <Button Grid.Column="9" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" Classes="accent" />
          <Button Grid.Column="11" Content="{x:Static p:Tekst.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="13" Content="{x:Static p:Tekst.Remove}" Command="{Binding RemoveCommand}"
                  IsVisible="{Binding IsEditing}" />
        </Grid>
      </Border>

      <!-- The open account's history, every period, newest first. Its own acts are here: renaming,
           deleting it while unused, making it the Hoofdrekening, and correcting its balance. On a
           row, a transfer can be changed and removed, a balance correction removed; an income or
           expense is only listed, and is changed from the Overview. -->
      <Border Classes="card" Padding="10" IsVisible="{Binding IsHistoryOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !RenamingAccount}">
              <TextBlock Text="{Binding HistoryAccount.Name, FallbackValue=''}" FontSize="15" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Classes="link" Content="{x:Static p:Tekst.Rename}" Command="{Binding StartAccountRenameCommand}" />
              <Button Classes="link" Content="{x:Static p:Tekst.Delete}" Command="{Binding DeleteOpenAccountCommand}"
                      IsVisible="{Binding CanDeleteHistoryAccount}" />
              <Button Classes="link" Content="{x:Static p:Tekst.MakePool}" Command="{Binding MakeOpenAccountPoolCommand}"
                      IsVisible="{Binding CanMakeHistoryAccountPool}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding RenamingAccount}">
              <TextBox Text="{Binding NewAccountName}" MinWidth="200" Margin="0" />
              <Button Classes="link" Content="{x:Static p:Tekst.Save}" Command="{Binding SaveAccountRenameCommand}" />
              <Button Classes="link" Content="{x:Static p:Tekst.Cancel}" Command="{Binding CancelAccountRenameCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding BalanceInput}" PlaceholderText="{x:Static p:Tekst.Balance}" MinWidth="140" Margin="0" />
              <Button Content="{x:Static p:Tekst.CorrectBalance}" Command="{Binding CorrectOpenBalanceCommand}" />
              <Button Content="{x:Static p:Tekst.Close}" Command="{Binding CloseHistoryCommand}" />
            </StackPanel>
          </Grid>
          <ScrollViewer MaxHeight="150">
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:HistoryLine">
                  <Grid ColumnDefinitions="160,*,110,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Classes="caption" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" TextAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                      <Button Classes="link" Content="{x:Static p:Tekst.Change}" IsVisible="{Binding CanChange}"
                              Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).EditTransferCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="link" Content="{x:Static p:Tekst.Remove}" IsVisible="{Binding CanRemove}"
                              Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).RemoveFromHistoryCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- What MoneyBud said about the last thing done, and the one question it asks: whether to
         remove an entry, answered here in the message bar. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="6">
      <Border CornerRadius="6" Padding="12,8" Background="#FFF4E0" IsVisible="{Binding IsAsking}">
        <Grid ColumnDefinitions="*,12,Auto">
          <TextBlock Text="{Binding Question.Text, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static p:Tekst.Remove}" Command="{Binding ConfirmCommand}" Classes="accent" />
            <Button Content="{x:Static p:Tekst.Cancel}" Command="{Binding DeclineCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border CornerRadius="6" Padding="12,8"
              IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{Binding Notice.IsRefusal, Converter={x:Static d:NoticeBackground.Instance}, FallbackValue={x:Null}}">
        <TextBlock Text="{Binding Notice.Text, FallbackValue=''}" TextWrapping="Wrap" />
      </Border>
      <!-- The line for saving, beside the notice and the question rather than in their place: that
           changes are not saved, for as long as they are not, and then once that all is saved
           again (arc42 §12). -->
      <Border CornerRadius="6" Padding="12,8"
              IsVisible="{Binding SaveLine, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{Binding IsUnsaved, Converter={x:Static d:NoticeBackground.Instance}}">
        <TextBlock Text="{Binding SaveLine, FallbackValue=''}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,16,2*,16,*">

      <!-- ======================= Income ======================= -->
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{x:Static p:Tekst.Incomes}" />
          <StackPanel DockPanel.Dock="Top" DataContext="{Binding IncomeForm}" x:DataType="p:IncomeForm">
            <Border Classes="editing" IsVisible="{Binding IsEditing}">
              <TextBlock Text="{x:Static p:Tekst.Change}" FontSize="12" />
            </Border>
            <TextBox Text="{Binding Label}" PlaceholderText="{x:Static p:Tekst.Label}" />
            <TextBox Text="{Binding Amount}" PlaceholderText="{x:Static p:Tekst.Amount}" />
            <CalendarDatePicker SelectedDate="{Binding Date}" PlaceholderText="{x:Static p:Tekst.Today}"
                                HorizontalAlignment="Stretch" />
            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="{x:Static p:Tekst.Account}"
                      ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).AccountChoices}"
                      SelectedItem="{Binding ChosenAccount}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="dom:Account">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding SubmitCommand}" Content="{Binding SubmitText}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
            <UniformGrid Columns="2" Margin="0,8,0,0" IsVisible="{Binding IsEditing}">
              <Button Content="{x:Static p:Tekst.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,4,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="{x:Static p:Tekst.Remove}" Command="{Binding RemoveCommand}" Margin="4,0,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
          </StackPanel>
          <Separator DockPanel.Dock="Top" Margin="0,14" />
          <Grid>
            <TextBlock Classes="caption" Text="{x:Static p:Tekst.NoIncomes}"
                       IsVisible="{Binding !Overview.Incomes.Count}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Overview.Incomes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:IncomeLine">
                    <Button Classes="entry" CommandParameter="{Binding}"
                            Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).EditIncomeCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding DateText}" Classes="caption" />
                          <TextBlock Text="{Binding AccountName}" Classes="caption"
                                     IsVisible="{Binding AccountName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ======================= The plan ======================= -->
      <Border Grid.Column="2" Classes="card">
        <!-- The ring takes most of the height the column has, and grows with the window; the
               rows below it scroll. -->
          <Grid RowDefinitions="Auto,3*,Auto,Auto,2*,Auto">
          <TextBlock Grid.Row="0" Classes="heading" Text="{x:Static p:Tekst.Overview}" />

          <!-- The ring is the column's centrepiece (arc42 §12, first demo). Its centre shows
               Niet toegewezen, or the row of the category slice pointed at; which of the two is
               MoneyBudApp's to say. The centre ignores the pointer, so the ring sees it there. -->
          <Panel Grid.Row="1" MinHeight="180" Margin="0,0,0,12" ClipToBounds="True">
            <d:RingControl Ring="{Binding Overview.Ring}" Pointed="{Binding PointedSlice}"
                           App="{Binding}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Spacing="4"
                        IsHitTestVisible="False">
              <TextBlock Text="{Binding Overview.RingHint}" IsVisible="{Binding Overview.Ring.IsEmpty}"
                         TextWrapping="Wrap" TextAlignment="Center" Classes="caption" />

              <StackPanel IsVisible="{Binding RingCentreShowsUnassigned}" Spacing="4">
                <TextBlock Text="{x:Static p:Tekst.Unassigned}" Classes="caption" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Overview.UnassignedText}" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Border Classes="marker" IsVisible="{Binding Overview.IsOverAssigned}" HorizontalAlignment="Center">
                  <TextBlock Text="{x:Static p:Tekst.OverAssigned}" />
                </Border>
              </StackPanel>

              <Panel IsVisible="{Binding PointedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel DataContext="{Binding PointedRow}" x:DataType="p:CategoryRow" Spacing="3">
                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Static p:Tekst.Archived}" Classes="caption" HorizontalAlignment="Center"
                           IsVisible="{Binding IsArchived}" />
                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                  <TextBlock Grid.Row="0" Text="{x:Static p:Tekst.Budget}" Classes="caption" TextAlignment="Right" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BudgetText}" />
                  <TextBlock Grid.Row="1" Text="{x:Static p:Tekst.Spent}" Classes="caption" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpentText}" />
                  <TextBlock Grid.Row="2" Text="{x:Static p:Tekst.Remaining}" Classes="caption" TextAlignment="Right" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RemainingText}" FontWeight="SemiBold" />
                </Grid>
                <Border Classes="marker" IsVisible="{Binding IsOverBudget}" HorizontalAlignment="Center">
                  <TextBlock Text="{x:Static p:Tekst.OverBudget}" />
                </Border>
              </StackPanel>
              </Panel>
            </StackPanel>
          </Panel>

          <!-- Assigning: its period starts as the one on screen and can be moved on its own. Under
               it, while a plan is offered, the button that takes the plan over into the period on
               screen (arc42 §12, Opening a period). -->
          <StackPanel Grid.Row="2" Margin="0,0,0,12" Spacing="8">
          <Grid DataContext="{Binding AssignForm}" x:DataType="p:AssignForm"
                ColumnDefinitions="*,8,*,12,Auto,Auto,Auto,8,Auto">
            <AutoCompleteBox Grid.Column="0" Text="{Binding Category}" Margin="0"
                             PlaceholderText="{x:Static p:Tekst.Category}" FilterMode="Custom" TextFilter="{x:Static d:Suggestions.Filter}"
                             MinimumPrefixLength="0"
                             ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).CategorySuggestions}" />
            <TextBox Grid.Column="2" Text="{Binding Amount}" PlaceholderText="{x:Static p:Tekst.Amount}" Margin="0" />
            <Button Grid.Column="4" Content="‹" Command="{Binding EarlierPeriodCommand}" />
            <TextBlock Grid.Column="5" Text="{Binding PeriodTitle}" VerticalAlignment="Center" Margin="6,0" />
            <Button Grid.Column="6" Content="›" Command="{Binding LaterPeriodCommand}" />
            <Button Grid.Column="8" Content="{x:Static p:Tekst.Assign}" Command="{Binding SubmitCommand}"
                    Classes="accent" />
          </Grid>
          <Button IsVisible="{Binding Overview.HasOffer}" Content="{Binding Overview.OfferText}"
                  Command="{Binding TakeOverCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>

          <!-- Adding a category. -->
          <Grid Grid.Row="5" ColumnDefinitions="*,8,Auto" Margin="0,12,0,0"
                DataContext="{Binding CategoryForm}" x:DataType="p:CategoryForm">
            <TextBox Text="{Binding Name}" PlaceholderText="{x:Static p:Tekst.Category}" Margin="0" />
            <Button Grid.Column="2" Command="{Binding SubmitCommand}" Content="{x:Static p:Tekst.AddCategory}" />
          </Grid>

          <!-- One row per category the period shows, in the ring's order. Under each name, its
               acts: Hernoemen always, Archiveren while in use, Verwijderen only when it has no
               history anywhere — two separate buttons, so nothing is decided for the user. -->
          <Grid Grid.Row="3" ColumnDefinitions="18,*,104,86,92,90" Margin="0,0,0,4">
            <TextBlock Grid.Column="1" Classes="caption" Text="{x:Static p:Tekst.Category}" />
            <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static p:Tekst.Budget}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="caption" Text="{x:Static p:Tekst.Spent}" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="caption" Text="{x:Static p:Tekst.Remaining}" TextAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Overview.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:CategoryRow">
                  <Grid ColumnDefinitions="18,*,104,86,92,90" Margin="0,3">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding SliceIndex, Converter={x:Static d:SliceColours.Swatch}}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsRenaming}">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static p:Tekst.Archived}" Classes="caption"
                                   IsVisible="{Binding IsArchived}" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsRenaming}">
                        <Button Classes="link" Content="{x:Static p:Tekst.Rename}"
                                Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).StartRenameCommand}"
                                CommandParameter="{Binding Name}" />
                        <Button Classes="link" Content="{x:Static p:Tekst.Archive}" IsVisible="{Binding !IsArchived}"
                                Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).ArchiveCommand}"
                                CommandParameter="{Binding Name}" />
                        <Button Classes="link" Content="{x:Static p:Tekst.Delete}" IsVisible="{Binding CanDelete}"
                                Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).DeleteCommand}"
                                CommandParameter="{Binding Name}" />
                      </StackPanel>

                      <!-- Renaming: the name becomes a box, which starts out holding it. -->
                      <TextBox IsVisible="{Binding IsRenaming}" Margin="0,0,8,0"
                               Text="{Binding $parent[Window].((p:MoneyBudApp)DataContext).NewName}" />
                      <StackPanel Orientation="Horizontal" IsVisible="{Binding IsRenaming}">
                        <Button Classes="link" Content="{x:Static p:Tekst.Save}"
                                Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).RenameCommand}" />
                        <Button Classes="link" Content="{x:Static p:Tekst.Cancel}"
                                Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).CancelRenameCommand}" />
                      </StackPanel>
                    </StackPanel>
                    <!-- While a plan is offered, the figure the row would take over, in grey under
                         its Budget; no figure at all for a category not in the plan. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding BudgetText}" TextAlignment="Right" />
                      <TextBlock Text="{Binding PlanText}" TextAlignment="Right" Classes="caption"
                                 IsVisible="{Binding PlanText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding SpentText}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding RemainingText}" TextAlignment="Right" VerticalAlignment="Center" />
                    <Border Grid.Column="5" Classes="marker" IsVisible="{Binding IsOverBudget}"
                            HorizontalAlignment="Center">
                      <TextBlock Text="{x:Static p:Tekst.OverBudget}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ======================= Expenses ======================= -->
      <Border Grid.Column="4" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{x:Static p:Tekst.Expenses}" />
          <StackPanel DockPanel.Dock="Top" DataContext="{Binding ExpenseForm}" x:DataType="p:ExpenseForm">
            <Border Classes="editing" IsVisible="{Binding IsEditing}">
              <TextBlock Text="{x:Static p:Tekst.Change}" FontSize="12" />
            </Border>
            <TextBox Text="{Binding Label}" PlaceholderText="{x:Static p:Tekst.Label}" />
            <AutoCompleteBox Text="{Binding Category}" PlaceholderText="{x:Static p:Tekst.Category}"
                             FilterMode="Custom" TextFilter="{x:Static d:Suggestions.Filter}" MinimumPrefixLength="0"
                             ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).CategorySuggestions}" />
            <TextBox Text="{Binding Amount}" PlaceholderText="{x:Static p:Tekst.Amount}" />
            <CalendarDatePicker SelectedDate="{Binding Date}" PlaceholderText="{x:Static p:Tekst.Today}"
                                HorizontalAlignment="Stretch" />
            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="{x:Static p:Tekst.Account}"
                      ItemsSource="{Binding $parent[Window].((p:MoneyBudApp)DataContext).AccountChoices}"
                      SelectedItem="{Binding ChosenAccount}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="dom:Account">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding SubmitCommand}" Content="{Binding SubmitText}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
            <UniformGrid Columns="2" Margin="0,8,0,0" IsVisible="{Binding IsEditing}">
              <Button Content="{x:Static p:Tekst.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,4,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="{x:Static p:Tekst.Remove}" Command="{Binding RemoveCommand}" Margin="4,0,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
          </StackPanel>
          <Separator DockPanel.Dock="Top" Margin="0,14" />
          <Grid>
            <TextBlock Classes="caption" Text="{x:Static p:Tekst.NoExpenses}"
                       IsVisible="{Binding !Overview.Expenses.Count}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Overview.Expenses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:ExpenseLine">
                    <Button Classes="entry" CommandParameter="{Binding}"
                            Command="{Binding $parent[Window].((p:MoneyBudApp)DataContext).EditExpenseCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Label}" IsVisible="{Binding Label, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Text="{Binding DateText}" Classes="caption" />
                          <TextBlock Text="{Binding AccountName}" Classes="caption"
                                     IsVisible="{Binding AccountName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
