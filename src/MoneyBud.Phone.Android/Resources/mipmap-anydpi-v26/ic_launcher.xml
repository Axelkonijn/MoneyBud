<?xml version="1.0" encoding="utf-8"?>
<!-- MoneyBud's launcher icon, made from docs/logo by render.ps1: the sticker over a transparent
     background, so the launcher shows it die-cut; the monochrome layer is for themed icons. Android
     also shows it on the dark screen while MoneyBud starts. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@android:color/transparent" />
  <foreground android:drawable="@mipmap/ic_launcher_foreground" />
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
