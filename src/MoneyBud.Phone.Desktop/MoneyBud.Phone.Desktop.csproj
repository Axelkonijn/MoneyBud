<Project Sdk="Microsoft.NET.Sdk">

  <!-- The phone on the PC, for developing without the phone (plan for increment 14, D1, D9): the
       phone's screens in a phone-sized window, on a data folder of its own; and, with "snapshot",
       pictures of every screen from a headless run over synthetic data. Not something anyone uses:
       MoneyBud is used on the phone, and developed on the desktop. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoneyBud.Phone\MoneyBud.Phone.csproj" />
  </ItemGroup>

</Project>
